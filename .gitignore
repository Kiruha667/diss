# raw data, interim artifacts and embedding caches are never committed (AGENTS.md 2.3)
data/*
# demo data (DEMO_COLAB.md): runs.parquet, examples.json and the card are committed; steps.parquet and
# demo_lib.zip are published as GitHub Release assets only
!data/demo/
data/demo/steps.parquet
data/demo/steps.parquet.part
data/demo/demo_lib.zip
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
kaggle/build/
kaggle/pulled/

# features.csv is 109 MB (> GitHub 100 MB limit): the repo keeps outputs/features.csv.gz
outputs/features.csv

# pause request for own_data/infra/main.ps1 (main_lib.py STOP_FILE)
.own_main_stop

# blind key of the G0 human check (reports/G0_HUMAN_CHECK_PROTOCOL.md): never published before the author's marks are
# returned; commit afterwards with git add -f outputs/g0_human_key.csv
outputs/g0_human_key.csv
# pytest cache, author's private documents
.pytest_cache/
*.docx
*.pdf

# the paper (paper/, LaTeX): the built PDF and the intermediate files of latexmk are never committed; the build is
# reported in paper/BUILD.md (python -m src.paper_build). Figure PDFs are covered by *.pdf above.
paper/main.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc

# working spreadsheets of the G0 human check (author's marks, review files): never committed; the marks go to CSV
*.xlsx
